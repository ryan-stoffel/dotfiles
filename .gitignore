# Nix build artifacts
result
result-*

# home-manager backups
*.hm-backup

# Secrets and machine-runtime state — NEVER commit
**/auth.json
**/sessions/
**/node_modules/
**/node_modules
**/models-store.json
*.yml.lock
*.secret
.env
.env.*

# age private key, if ever placed in-tree
**/keys.txt

# macOS cruft
.DS_Store

# Local development caches
__pycache__/
.direnv/

# Machine-local overrides — internal hosts and project paths stay untracked
ssh/config.local
projects/config.local.toml

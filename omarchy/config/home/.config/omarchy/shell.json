{
  "bar": {
    "background": "opaque",
    "layout": {
      "center": [],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ryan-stoffel.apple-menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "netmojo.omdrop"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "format": "ddd MMM d  h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "tray": [
        {
          "id": "superwhisper.panel"
        }
      ]
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "ryan-stoffel.menu",
    "ryan-stoffel.lock"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock"
  ],
  "dock": {
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ],
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "ryan-stoffel.sudo-touchid"
    },
    {
      "id": "ryan-stoffel.lock"
    },
    {
      "id": "ryan-stoffel.full-gaps"
    },
    {
      "id": "ryan-stoffel.menu"
    }
  ],
  "version": 1
}

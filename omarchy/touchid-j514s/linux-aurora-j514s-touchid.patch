--- a/drivers/soc/apple/profile.rs
+++ b/drivers/soc/apple/profile.rs
@@ -24,6 +24,7 @@
 //!   a powered sensor, so the driver uses the warm registration path.
 //! * `T8122` / J613, J615 (MacBook Air, M3): the T8112 warm registration with
 //!   the T8140 SEP DART aperture above 4 GiB.
+//! * `T6030` / J514s (MacBook Pro 14", M3 Pro): T8122 with spi2 moved.
 
 // The boot handshake, identity source, sensor and DART fields are consumed by
 // the boot-endpoint, identity and sensor-transport paths.
@@ -425,6 +426,20 @@ pub(crate) struct PlatformProfile {
     ..T8112
 };
 
+/// MacBook Pro 14" M3 Pro (J514s). The J514s ADT (27.0, 26A428) wires the
+/// SEP as J613's does: `iop-sep,ascwrap-v6` at the same address, the same DART
+/// window with the BIT(40) alias, and the same Mesa sensor (`R3`, identical
+/// `reg` bytes, 8 MHz, chip select 0) with power on NUB GPIO (pin 33). Only
+/// spi2 moves, to `0x289108000`. Otherwise [`T8122`]. Unproven on hardware.
+pub(crate) const T6030: PlatformProfile = PlatformProfile {
+    name: "T6030/J514s",
+    sensor: SensorProfile {
+        controller_base: 0x2_8910_8000,
+        ..T8122.sensor
+    },
+    ..T8122
+};
+
 static_assert!(T8103.shmem_capacity == 0x30000);
 static_assert!(T6020.shmem_capacity == 0x40000);
 static_assert!(T8140.shmem_capacity == 0x40000);
@@ -440,6 +455,7 @@ pub(crate) struct PlatformProfile {
 static_assert!(T8122.shmem_capacity == T8112.shmem_capacity);
 static_assert!(T8122.sensor.controller_base == 0x2a1108000);
 static_assert!(T8122.wide_dma_mask);
+static_assert!(T6030.sensor.controller_base == 0x289108000);
 
 /// Whether the machine root declares `compatible`.
 ///
@@ -586,6 +602,10 @@ pub(crate) fn detect() -> Result<&'static PlatformProfile> {
     if machine_has(b"apple,t8122") && (machine_has(b"apple,j613") || machine_has(b"apple,j615")) {
         return Ok(&T8122);
     }
+    // Only J514s's ADT was read; J516s shares the SoC but is unchecked.
+    if machine_has(b"apple,t6030") && machine_has(b"apple,j514s") {
+        return Ok(&T6030);
+    }
     Err(ENODEV)
 }
 

+		};
+
+		sep: sep@29e400000 {
+			compatible = "apple,sep";
+			reg = <0x2 0x9e400000 0x0 0x6c000>;
+			mboxes = <&sep_mbox>;
+			mbox-names = "mbox";
+			iommus = <&sep_dart 0>;
+			status = "disabled";
+		};
+
+		sep_mbox: mbox@29e408000 {
+			compatible = "apple,t6030-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x2 0x9e408000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 366 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 367 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 368 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 369 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+				"recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+		};
+

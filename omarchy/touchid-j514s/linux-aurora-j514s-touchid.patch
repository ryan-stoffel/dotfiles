--- a/arch/arm64/boot/dts/apple/t6030-j514s.dts
+++ b/arch/arm64/boot/dts/apple/t6030-j514s.dts
@@ -18,6 +18,10 @@ / {
 	compatible = "apple,j514s", "apple,t6030", "apple,arm-platform";
 	model = "Apple MacBook Pro (14-inch, M3 Pro, Nov 2023)";
 
+	aliases {
+		sep = &sep;
+	};
+
 	chosen {
 		asahi,t6030-dispext = "1";
 	};
@@ -97,3 +101,22 @@ &sound {
 &isp {
 	apple,platform-id = <16>;
 };
+
+/*
+ * Mesa fingerprint sensor on spi2 (J514s ADT /arm-io/spi2/mesa): power on
+ * NUB GPIO 33, active high. The data-ready line (AP GPIO 200) is left out,
+ * so the driver polls until its trigger is confirmed. Native chip select
+ * only. The ADT's sensor (R3), SPI reg bytes and 8 MHz clock match J613's.
+ */
+&spi2 {
+	status = "okay";
+};
+
+&mesa {
+	status = "okay";
+	enable-gpios = <&pinctrl_nub 33 GPIO_ACTIVE_HIGH>;
+	spi-cs-setup-delay-ns = <20>;
+	spi-cs-hold-delay-ns = <20>;
+	/* Per-device factory data from this Mac's own iBoot system container. */
+	firmware-name = "apple/mesacal-j514s.bin";
+};

// Dev workspace layout. Run with: zellij --layout dev
//
// ---------------------------------------------------
// |                    |             AI             |
// |                    |           (shell)          |
// |  Main Terminal     |----------------------------|
// |  (Dev Work)        | Dev Laptop   |     VM      |
// |                    | (ssh dev)    |  (ssh vm)   |
// ---------------------------------------------------
//
// split_direction="vertical" lays children out side by side;
// "horizontal" stacks them. "command" is a pane attribute; "args" is a
// child node.

layout {
    pane split_direction="vertical" {
        pane size="55%"
        pane split_direction="horizontal" {
            pane command="zsh"
            pane size="40%" split_direction="vertical" {
                pane command="ssh" {
                    args "dev"
                }
                pane command="ssh" {
                    args "vm"
                }
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="compact-bar"
    }
}
